{
  "name": "inprisma",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Template placeholder system: one validated content source rendered for web, Medium, LinkedIn and Substack.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estudionebulosa/inprisma.git"
  },
  "homepage": "https://github.com/estudionebulosa/inprisma#readme",
  "bugs": {
    "url": "https://github.com/estudionebulosa/inprisma/issues"
  },
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve",
    "clean": "rm -rf _site",
    "generate": "node scripts/generate-schema.js",
    "validate": "node scripts/validate.js",
    "check": "npm run generate && npm run validate && npm run build && npm run verify:jsonld",
    "verify:jsonld": "node scripts/verify-jsonld.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^5.4.2"
  }
}
