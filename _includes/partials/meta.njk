<title>{{ article.title }} · {{ site.name }}</title>
<meta name="description" content="{{ article.excerpt }}">
<meta name="author" content="{{ author.name }}">
{% if article.keywords and article.keywords.length %}<meta name="keywords" content="{{ article.keywords | join(', ') }}">{% endif %}
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
{% if article.date %}<meta name="article:published_time" content="{{ computed.publishedISO }}">{% endif %}
<link rel="canonical" href="{{ computed.canonicalUrl }}">
<meta name="generator" content="Eleventy">
