<!doctype html>
<html lang="{{ site.locale }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% include "partials/meta.njk" %}
  {% include "partials/social.njk" %}
  {% include "partials/jsonld.njk" %}
  <link rel="stylesheet" href="/assets/main.css">
</head>
<body>
  <header class="site-header">
    <a class="site-header__brand" href="{{ site.website }}">{{ site.name }}</a>
  </header>

  <main id="content">
    <article class="article" data-category="{{ article.category }}">
      <header class="article__header">
        <h1 class="article__title">{{ article.title }}</h1>
        {% if article.dek %}<p class="article__dek">{{ article.dek }}</p>{% endif %}
        {% include "partials/byline.njk" %}
      </header>

      {% if article.hook %}<p class="article__hook">{{ article.hook }}</p>{% endif %}

      <div class="article__body">
        {{ content | safe }}
      </div>

      {% include "partials/faq.njk" %}
      {% include "partials/sources.njk" %}

      {% if article.cta %}<p class="article__cta">{{ article.cta }}</p>{% endif %}

      {% if article.internalLinks and article.internalLinks.length %}
      <nav class="article__internal-links" aria-label="Contenido relacionado">
        <h2>Contenido relacionado</h2>
        <ul>
          {% for link in article.internalLinks %}
          <li><a href="{{ link | absoluteUrl(site.website) }}">{{ link }}</a></li>
          {% endfor %}
        </ul>
      </nav>
      {% endif %}
    </article>
  </main>

  <footer class="site-footer">
    <p>&copy; {{ site.name }} · {{ org.name }}</p>
  </footer>
</body>
</html>
