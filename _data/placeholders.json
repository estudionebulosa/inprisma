{
  "version": "1.0.0",
  "description": "Single source of truth for every placeholder in the system. Drives the generated JSON Schema, the generated CMS config, and CI validation. Do not edit generated artifacts by hand.",
  "platforms": ["medium", "linkedin", "substack"],
  "automationClasses": {
    "automated": "Derived at build time; never authored by hand.",
    "repetitive-global": "Set once in _data/admin.json; identical for every article.",
    "repetitive-article": "Per-article front matter, validated against this contract.",
    "variable-manual": "Human, platform-tuned; minor variation across platforms is acceptable."
  },
  "fields": [
    {
      "key": "site.name",
      "scope": "site",
      "class": "repetitive-global",
      "type": "string",
      "required": true,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "minLength": 1, "maxLength": 60 },
      "description": "Public name of the site / brand."
    },
    {
      "key": "site.title",
      "scope": "site",
      "class": "repetitive-global",
      "type": "string",
      "required": false,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "maxLength": 120 },
      "description": "Tagline shown in site-level surfaces (footer, RSS channel)."
    },
    {
      "key": "site.website",
      "scope": "site",
      "class": "repetitive-global",
      "type": "url",
      "required": true,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "format": "uri" },
      "description": "Canonical origin of the self-hosted site (no trailing slash)."
    },
    {
      "key": "site.locale",
      "scope": "site",
      "class": "repetitive-global",
      "type": "string",
      "required": true,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
      "description": "Language/region, e.g. es-ES, en-US."
    },
    {
      "key": "site.logo",
      "scope": "site",
      "class": "repetitive-global",
      "type": "image",
      "required": true,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "format": "uri-reference" },
      "description": "Site logo used in JSON-LD publisher and default OG image."
    },
    {
      "key": "site.social.x",
      "scope": "site",
      "class": "repetitive-global",
      "type": "url",
      "required": false,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "format": "uri" },
      "description": "X (Twitter) profile URL."
    },
    {
      "key": "site.social.linkedin",
      "scope": "site",
      "class": "repetitive-global",
      "type": "url",
      "required": false,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "format": "uri" },
      "description": "LinkedIn page/profile URL."
    },
    {
      "key": "site.social.github",
      "scope": "site",
      "class": "repetitive-global",
      "type": "url",
      "required": false,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "format": "uri" },
      "description": "GitHub organisation/profile URL."
    },
    {
      "key": "site.social.youtube",
      "scope": "site",
      "class": "repetitive-global",
      "type": "url",
      "required": false,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "format": "uri" },
      "description": "YouTube channel URL."
    },

    {
      "key": "author.id",
      "scope": "author",
      "class": "repetitive-global",
      "type": "string",
      "required": true,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "pattern": "^[a-z0-9-]+$" },
      "description": "Stable slug used by article.author to reference the admin."
    },
    {
      "key": "author.name",
      "scope": "author",
      "class": "repetitive-global",
      "type": "string",
      "required": true,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "minLength": 1, "maxLength": 80 },
      "description": "Display name of the site administrator (E-E-A-T byline)."
    },
    {
      "key": "author.title",
      "scope": "author",
      "class": "repetitive-global",
      "type": "string",
      "required": true,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "maxLength": 100 },
      "description": "Professional title, e.g. 'Editor de tecnología'."
    },
    {
      "key": "author.bio",
      "scope": "author",
      "class": "repetitive-global",
      "type": "text",
      "required": false,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "maxLength": 400 },
      "description": "Short biography appended to every article."
    },
    {
      "key": "author.credentials",
      "scope": "author",
      "class": "repetitive-global",
      "type": "array<string>",
      "required": false,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "maxItems": 5, "items": { "maxLength": 80 } },
      "description": "Verifiable credentials supporting E-E-A-T."
    },
    {
      "key": "author.email",
      "scope": "author",
      "class": "repetitive-global",
      "type": "string",
      "required": false,
      "auto": true,
      "variationAllowed": false,
      "platforms": [],
      "validation": { "format": "email" },
      "description": "Contact address used in JSON-LD only; never rendered publicly."
    },
    {
      "key": "author.website",
      "scope": "author",
      "class": "repetitive-global",
      "type": "url",
      "required": false,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "format": "uri" },
      "description": "Author website or profile page."
    },
    {
      "key": "author.avatar",
      "scope": "author",
      "class": "repetitive-global",
      "type": "image",
      "required": false,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "format": "uri-reference" },
      "description": "Author portrait for byline and JSON-LD image."
    },
    {
      "key": "author.sameAs",
      "scope": "author",
      "class": "repetitive-global",
      "type": "array<url>",
      "required": false,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "items": { "format": "uri" } },
      "description": "Authoritative profiles for JSON-LD Person.sameAs."
    },

    {
      "key": "org.name",
      "scope": "org",
      "class": "repetitive-global",
      "type": "string",
      "required": true,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "minLength": 1, "maxLength": 100 },
      "description": "Publisher organisation name."
    },
    {
      "key": "org.legalName",
      "scope": "org",
      "class": "repetitive-global",
      "type": "string",
      "required": false,
      "auto": true,
      "variationAllowed": false,
      "platforms": [],
      "validation": { "maxLength": 120 },
      "description": "Registered legal name, if different from org.name."
    },
    {
      "key": "org.url",
      "scope": "org",
      "class": "repetitive-global",
      "type": "url",
      "required": true,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "format": "uri" },
      "description": "Organisation home page (usually equal to site.website)."
    },
    {
      "key": "org.logo",
      "scope": "org",
      "class": "repetitive-global",
      "type": "image",
      "required": true,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "format": "uri-reference" },
      "description": "Publisher logo for JSON-LD."
    },
    {
      "key": "org.sameAs",
      "scope": "org",
      "class": "repetitive-global",
      "type": "array<url>",
      "required": false,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "items": { "format": "uri" } },
      "description": "Organisation profiles for JSON-LD."
    },

    {
      "key": "article.slug",
      "scope": "article",
      "class": "repetitive-article",
      "type": "string",
      "required": false,
      "auto": false,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "pattern": "^[a-z0-9-]+$", "maxLength": 60 },
      "description": "Stable URL slug. Defaults to a slugified title; set it to keep URLs predictable so internal links never break when the title changes."
    },
    {
      "key": "article.title",
      "scope": "article",
      "class": "repetitive-article",
      "type": "string",
      "required": true,
      "auto": false,
      "variationAllowed": true,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "minLength": 15, "maxLength": 60 },
      "description": "Headline. Used for <title>, og:title and JSON-LD headline. Minor per-platform rewording is allowed."
    },
    {
      "key": "article.dek",
      "scope": "article",
      "class": "repetitive-article",
      "type": "string",
      "required": false,
      "auto": false,
      "variationAllowed": true,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "maxLength": 200 },
      "description": "Sub-headline / standfirst shown under the title."
    },
    {
      "key": "article.category",
      "scope": "article",
      "class": "repetitive-article",
      "type": "string",
      "required": true,
      "auto": false,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "pattern": "^[a-z0-9-]+$" },
      "description": "Top-level taxonomy bucket; becomes the first URL segment."
    },
    {
      "key": "article.tags",
      "scope": "article",
      "class": "repetitive-article",
      "type": "array<string>",
      "required": true,
      "auto": false,
      "variationAllowed": true,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": {
        "minItems": 1,
        "maxItems": 5,
        "items": { "pattern": "^[a-z0-9-]+$", "maxLength": 30 },
        "platformOverrides": { "linkedin": { "maxItems": 3 } }
      },
      "description": "Discovery tags/hashtags. Caps differ per platform."
    },
    {
      "key": "article.author",
      "scope": "article",
      "class": "repetitive-article",
      "type": "string",
      "required": false,
      "auto": false,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "pattern": "^[a-z0-9-]+$" },
      "description": "Reference to author.id. Defaults to the admin author when omitted."
    },
    {
      "key": "article.revision",
      "scope": "article",
      "class": "repetitive-article",
      "type": "string",
      "required": true,
      "auto": false,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "pattern": "^\\d+\\.\\d+$" },
      "description": "Content revision, e.g. 1.0. Bumped on meaningful edits."
    },
    {
      "key": "article.date",
      "scope": "article",
      "class": "repetitive-article",
      "type": "date",
      "required": true,
      "auto": false,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "format": "date" },
      "description": "Original publication date (ISO 8601)."
    },
    {
      "key": "article.updated",
      "scope": "article",
      "class": "repetitive-article",
      "type": "date",
      "required": false,
      "auto": false,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "format": "date" },
      "description": "Last meaningful update. Falls back to article.date."
    },
    {
      "key": "article.excerpt",
      "scope": "article",
      "class": "repetitive-article",
      "type": "text",
      "required": true,
      "auto": false,
      "variationAllowed": true,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "minLength": 120, "maxLength": 160 },
      "description": "Meta description / social summary (120-160 chars, PRD gate). Answer-first sentence preferred (AEO)."
    },
    {
      "key": "article.keywords",
      "scope": "article",
      "class": "repetitive-article",
      "type": "array<string>",
      "required": false,
      "auto": false,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "maxItems": 10, "items": { "maxLength": 40 } },
      "description": "SEO keywords for the meta keywords tag and JSON-LD."
    },
    {
      "key": "article.hero.image",
      "scope": "article",
      "class": "repetitive-article",
      "type": "image",
      "required": true,
      "auto": false,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "format": "uri-reference" },
      "description": "Hero / social share image (1200x630 recommended)."
    },
    {
      "key": "article.hero.alt",
      "scope": "article",
      "class": "repetitive-article",
      "type": "string",
      "required": true,
      "auto": false,
      "variationAllowed": true,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "minLength": 5, "maxLength": 125 },
      "description": "Hero image alt text (accessibility + PRD gate)."
    },
    {
      "key": "article.faq",
      "scope": "article",
      "class": "repetitive-article",
      "type": "array<object>",
      "required": false,
      "auto": false,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": {
        "items": {
          "required": ["q", "a"],
          "properties": {
            "q": { "maxLength": 160 },
            "a": { "maxLength": 600 }
          }
        }
      },
      "description": "Question/answer pairs rendered in the body and emitted as FAQPage JSON-LD."
    },
    {
      "key": "article.sources",
      "scope": "article",
      "class": "repetitive-article",
      "type": "array<object>",
      "required": false,
      "auto": false,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": {
        "items": {
          "required": ["text", "url"],
          "properties": {
            "text": { "maxLength": 160 },
            "url": { "format": "uri-reference" }
          }
        }
      },
      "description": "Cited sources; strengthens E-E-A-T and AEO citations."
    },
    {
      "key": "article.internalLinks",
      "scope": "article",
      "class": "repetitive-article",
      "type": "array<url>",
      "required": true,
      "auto": false,
      "variationAllowed": false,
      "platforms": [],
      "validation": { "minItems": 3, "maxItems": 5, "items": { "format": "uri-reference" } },
      "description": "Contextual internal links; PRD requires 3-5 per article."
    },

    {
      "key": "article.hook",
      "scope": "article",
      "class": "variable-manual",
      "type": "text",
      "required": false,
      "auto": false,
      "variationAllowed": true,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "maxLength": 280 },
      "description": "Opening hook tuned for engagement/retention."
    },
    {
      "key": "article.cta",
      "scope": "article",
      "class": "variable-manual",
      "type": "string",
      "required": false,
      "auto": false,
      "variationAllowed": true,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "maxLength": 160 },
      "description": "Call to action closing the article."
    },
    {
      "key": "article.shareCopy",
      "scope": "article",
      "class": "variable-manual",
      "type": "text",
      "required": false,
      "auto": false,
      "variationAllowed": true,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "maxLength": 280 },
      "description": "Suggested social share text."
    },
    {
      "key": "article.platform.medium.kicker",
      "scope": "article",
      "class": "variable-manual",
      "type": "string",
      "required": false,
      "auto": false,
      "variationAllowed": true,
      "platforms": ["medium"],
      "validation": { "maxLength": 120 },
      "description": "Medium kicker / small label above the title."
    },
    {
      "key": "article.platform.linkedin.framing",
      "scope": "article",
      "class": "variable-manual",
      "type": "text",
      "required": false,
      "auto": false,
      "variationAllowed": true,
      "platforms": ["linkedin"],
      "validation": { "maxLength": 300 },
      "description": "LinkedIn-specific framing line (professional tone)."
    },
    {
      "key": "article.platform.substack.subject",
      "scope": "article",
      "class": "variable-manual",
      "type": "string",
      "required": false,
      "auto": false,
      "variationAllowed": true,
      "platforms": ["substack"],
      "validation": { "maxLength": 120 },
      "description": "Substack email subject / preview text."
    },

    {
      "key": "computed.slug",
      "scope": "computed",
      "class": "automated",
      "type": "string",
      "required": true,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "pattern": "^[a-z0-9-]+$" },
      "description": "URL slug derived from article.title."
    },
    {
      "key": "computed.canonicalUrl",
      "scope": "computed",
      "class": "automated",
      "type": "url",
      "required": true,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "format": "uri" },
      "description": "Absolute canonical URL on the self-hosted site."
    },
    {
      "key": "computed.publishedISO",
      "scope": "computed",
      "class": "automated",
      "type": "string",
      "required": true,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "format": "date-time" },
      "description": "article.date normalised to ISO 8601."
    },
    {
      "key": "computed.modifiedISO",
      "scope": "computed",
      "class": "automated",
      "type": "string",
      "required": true,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "format": "date-time" },
      "description": "article.updated (or article.date) normalised to ISO 8601."
    },
    {
      "key": "computed.readingTime",
      "scope": "computed",
      "class": "automated",
      "type": "number",
      "required": true,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "minimum": 1 },
      "description": "Estimated reading time in minutes."
    },
    {
      "key": "computed.wordCount",
      "scope": "computed",
      "class": "automated",
      "type": "number",
      "required": true,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "minimum": 0 },
      "description": "Body word count."
    },
    {
      "key": "computed.ogImagePath",
      "scope": "computed",
      "class": "automated",
      "type": "image",
      "required": true,
      "auto": true,
      "variationAllowed": false,
      "platforms": ["medium", "linkedin", "substack"],
      "validation": { "format": "uri-reference" },
      "description": "Absolute or root-relative OG image, generated from a template."
    },
    {
      "key": "computed.sitemapLastmod",
      "scope": "computed",
      "class": "automated",
      "type": "string",
      "required": true,
      "auto": true,
      "variationAllowed": false,
      "platforms": [],
      "validation": { "format": "date-time" },
      "description": "Sitemap lastmod value; equals modifiedISO."
    },
    {
      "key": "computed.jsonld",
      "scope": "computed",
      "class": "automated",
      "type": "object",
      "required": true,
      "auto": true,
      "variationAllowed": false,
      "platforms": [],
      "validation": {},
      "description": "Assembled JSON-LD graph (NewsArticle, FAQPage, BreadcrumbList, Person, Organization)."
    }
  ]
}
